#!/bin/sh
# post-merge — redeploy only an already active dibsd on main.
#
# Installed via `make install-hooks` (sets core.hooksPath to this directory).
# Keep the legacy service switch manual. try-restart prevents a race where the
# daemon becomes inactive after the is-active probe.
set -u

repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
branch=$(git -C "$repo_root" rev-parse --abbrev-ref HEAD 2>/dev/null) || exit 0

if [ "$branch" != "main" ]; then
	exit 0
fi

systemctl_user="$repo_root/contrib/install/systemctl-user.sh"
if sh "$systemctl_user" is-active --quiet dibsd >/dev/null 2>&1; then
	if ! make -C "$repo_root" build-install; then
		echo "post-merge: dibsd build failed; redeploy manually" >&2
		exit 0
	fi
	if ! sh "$systemctl_user" try-restart dibsd; then
		echo "post-merge: dibsd try-restart failed; redeploy manually" >&2
	fi
elif sh "$systemctl_user" is-active --quiet af-coordinatord >/dev/null 2>&1; then
	echo "post-merge: legacy daemon active; switch manually via docs/operations.md" >&2
else
	echo "post-merge: no active daemon; no redeploy" >&2
fi

exit 0
